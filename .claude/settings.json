{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bun .claude/hooks/inject-agent-markers.ts",
            "type": "command"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bun .claude/hooks/inject-expertise.ts",
            "type": "command"
          },
          {
            "command": "bun .claude/hooks/session-logger.ts",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bun .claude/hooks/inject-expertise.ts",
            "type": "command"
          },
          {
            "command": "bun .claude/hooks/session-logger.ts",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "bun .claude/hooks/session-logger.ts",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bun .claude/hooks/inject-expertise.ts",
            "type": "command"
          },
          {
            "command": "bun .claude/hooks/session-logger.ts",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bun .claude/hooks/*)",
      "Bash(bun .claude/skills/delegate/scripts/*)",
      "Write(.claude/**)",
      "Edit(.claude/**)",
      "MultiEdit(.claude/**)"
    ]
  }
}